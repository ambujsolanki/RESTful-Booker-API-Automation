{
  "info": {
    "_postman_id": "02af40b6-3a57-4f59-a738-4aefb278b5f2",
    "name": "RESTful-Booker-API-Automation",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "34716932"
  },
  "item": [
    {
      "name": "1. Generate Auth Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Parse the JSON response body",
              "const response = pm.response.json();",
              "",
              "// Check if the token exists, then save it to our environment",
              "if (response.token) {",
              "    pm.environment.set(\"authToken\", response.token);",
              "    console.log(\"Token saved: \" + response.token);",
              "} else {",
              "    console.log(\"Error: Token not found in response\");",
              "}",
              "",
              "// Add a quick automated test to verify the status code",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"username\" : \"admin\",\n    \"password\" : \"password123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth"
          ]
        }
      },
      "response": []
    },
    {
      "name": "2. Create Booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const response = pm.response.json();\n\n// Save the dynamic booking ID to our environment variables\nif (response.bookingid) {\n    pm.environment.set(\"bookingId\", response.bookingid);\n}\n\n// Validate the server created the record successfully\npm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});\n\n// Validate the data integrity of the response dynamically using the CSV\npm.test(\"First name matches payload\", function () {\n    pm.expect(response.booking.firstname).to.eql(pm.iterationData.get(\"firstName\"));\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"firstname\" : \"{{firstName}}\",\n    \"lastname\" : \"{{lastName}}\",\n    \"totalprice\" : {{price}},\n    \"depositpaid\" : true,\n    \"bookingdates\" : {\n        \"checkin\" : \"2026-12-01\",\n        \"checkout\" : \"2026-12-05\"\n    },\n    \"additionalneeds\" : \"Data Driven Testing\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/booking",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "booking"
          ]
        }
      },
      "response": []
    },
    {
      "name": "3. Update Booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const response = pm.response.json();\n\npm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"Price successfully updated to 250\", function () {\n    pm.expect(response.totalprice).to.eql(250);\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Cookie",
            "value": "token={{authToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"firstname\": \"{{firstName}}\",\n    \"lastname\": \"{{lastName}}\",\n    \"totalprice\": 250,\n    \"depositpaid\": true,\n    \"bookingdates\": {\n        \"checkin\": \"2026-12-01\",\n        \"checkout\": \"2026-12-05\"\n    },\n    \"additionalneeds\": \"API Automation Mastery\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/booking/{{bookingId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "booking",
            "{{bookingId}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "4. Update Booking - Missing Auth",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Security: Server rejects unauthorized update with 403 Forbidden\", function () {\n    pm.response.to.have.status(403);\n});\n\npm.test(\"Response text indicates Forbidden\", function () {\n    pm.expect(pm.response.text()).to.include(\"Forbidden\");\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Cookie",
            "value": "token=INVALID_TOKEN_123"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"firstname\": \"{{firstName}}\",\n    \"lastname\": \"{{lastName}}\",\n    \"totalprice\": 250,\n    \"depositpaid\": true,\n    \"bookingdates\": {\n        \"checkin\": \"2026-12-01\",\n        \"checkout\": \"2026-12-05\"\n    },\n    \"additionalneeds\": \"API Automation Mastery\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/booking/{{bookingId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "booking",
            "{{bookingId}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "5. Delete Booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () {\n    pm.response.to.have.status(201);\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Cookie",
            "value": "token={{authToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/booking/{{bookingId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "booking",
            "{{bookingId}}"
          ]
        }
      },
      "response": []
    }
  ]
}